{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Node.js: All Tests (PostgreSQL)",
      "type": "dart",
      "request": "launch",
      "program": "test/",
      "cwd": "${workspaceFolder}",
      "console": "debugConsole",
      "env": {
        "DB_TYPE": "postgres"
      },
      "presentation": {
        "group": "1 - Node.js Tests",
        "order": 1
      }
    },
    {
      "name": "Node.js: All Tests (MySQL)",
      "type": "dart",
      "request": "launch",
      "program": "test/",
      "cwd": "${workspaceFolder}",
      "console": "debugConsole",
      "env": {
        "DB_TYPE": "mysql"
      },
      "presentation": {
        "group": "1 - Node.js Tests",
        "order": 2
      }
    },
    {
      "name": "Node.js: All Tests (MariaDB)",
      "type": "dart",
      "request": "launch",
      "program": "test/",
      "cwd": "${workspaceFolder}",
      "console": "debugConsole",
      "env": {
        "DB_TYPE": "mariadb"
      },
      "presentation": {
        "group": "1 - Node.js Tests",
        "order": 3
      }
    },
    {
      "name": "Node.js: Active File Test (PostgreSQL)",
      "type": "dart",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "debugConsole",
      "env": {
        "DB_TYPE": "postgres"
      },
      "presentation": {
        "group": "1 - Node.js Tests",
        "order": 4
      }
    },
    {
      "name": "QuickJS: All Tests (PostgreSQL)",
      "type": "dart",
      "request": "launch",
      "program": "test/",
      "cwd": "${workspaceFolder}",
      "console": "debugConsole",
      "env": {
        "DB_TYPE": "postgres",
        "USE_QUICKJS": "true"
      },
      "presentation": {
        "group": "2 - QuickJS Tests",
        "order": 1
      }
    },
    {
      "name": "QuickJS: All Tests (MySQL)",
      "type": "dart",
      "request": "launch",
      "program": "test/",
      "cwd": "${workspaceFolder}",
      "console": "debugConsole",
      "env": {
        "DB_TYPE": "mysql",
        "USE_QUICKJS": "true"
      },
      "presentation": {
        "group": "2 - QuickJS Tests",
        "order": 2
      }
    },
    {
      "name": "QuickJS: All Tests (MariaDB)",
      "type": "dart",
      "request": "launch",
      "program": "test/",
      "cwd": "${workspaceFolder}",
      "console": "debugConsole",
      "env": {
        "DB_TYPE": "mariadb",
        "USE_QUICKJS": "true"
      },
      "presentation": {
        "group": "2 - QuickJS Tests",
        "order": 3
      }
    },
    {
      "name": "QuickJS: Active File Test (PostgreSQL)",
      "type": "dart",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "debugConsole",
      "env": {
        "DB_TYPE": "postgres",
        "USE_QUICKJS": "true"
      },
      "presentation": {
        "group": "2 - QuickJS Tests",
        "order": 4
      }
    },
    {
      "name": "App: Debug Dart Server",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/example/lib/main.dart",
      "cwd": "${workspaceFolder}/example",
      "vmAdditionalArgs": ["--enable-asserts"],
      "console": "debugConsole",
      "presentation": {
        "group": "3 - Development & Apps",
        "order": 1
      }
    },
    {
      "name": "App: Debug Node.js (dart2js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/example/build/index.js",
      "cwd": "${workspaceFolder}/example",
      "sourceMaps": true,
      "preLaunchTask": "Build: dart2js",
      "outFiles": ["${workspaceFolder}/example/build/**/*.js"],
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "group": "3 - Development & Apps",
        "order": 2
      }
    },
    {
      "name": "Tools: Launch VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/tools/vscode/sequelize-dart-tools",
        "${workspaceFolder}"
      ],
      "presentation": {
        "group": "3 - Development & Apps",
        "order": 3
      }
    }
  ]
}
