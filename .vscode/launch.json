{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Sequelize Dart Tools Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/tools/vscode/sequelize-dart-tools",
        "${workspaceFolder}"
      ]
    },
    {
      "name": "Debug Dart Server",
      "type": "dart",
      "request": "launch",
      "debuggerType": "dart",
      "program": "${workspaceFolder}/example/lib/main.dart",
      "args": [
        "--dart-define=enable_asserts=true"
      ]
    },
    {
      "name": "Debug Node.js (dart2js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/example/build/index.js",
      "cwd": "${workspaceFolder}/example",
      "sourceMaps": true,
      "preLaunchTask": "Build: dart2js",
      "outFiles": [
        "${workspaceFolder}/example/build/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "cwd": "${workspaceFolder}",
      "console": "debugConsole",
      "name": "Dart: Run all Tests",
      "type": "dart",
      "request": "launch",
      "program": "./test/"
    },
    {
      "cwd": "${workspaceFolder}",
      "console": "debugConsole",
      "name": "Dart: Run Test",
      "type": "dart",
      "request": "launch",
      "program": "./test/"
    },
    {
      "name": "Run Tests (tools)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/tools/run.dart",
      "args": [
        "test"
      ],
      "cwd": "${workspaceFolder}",
      "console": "debugConsole"
    }
  ]
}